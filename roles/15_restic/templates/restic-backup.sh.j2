#!/usr/bin/env bash
# Auto-generated by ansible role 15_restic
set -euo pipefail

REPO="{{ restic_repo }}"
PWFILE="/etc/restic/password"

restic -r "$REPO" --password-file "$PWFILE" backup \
{% for p in restic_paths %}    "{{ p }}" \
{% endfor %}    --tag daily

restic -r "$REPO" --password-file "$PWFILE" forget \
    --keep-daily   {{ restic_keep_daily }} \
    --keep-weekly  {{ restic_keep_weekly }} \
    --keep-monthly {{ restic_keep_monthly }} \
    --prune

# Optional: Off-site sync (weekly only)
if [[ "$(date +%u)" == "7" ]]; then
    rclone sync "$REPO" "{{ vault_rclone_remote }}:ai-server-backups/" \
        --stats=10s --transfers=4
fi
