global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: nvidia
    static_configs:
      - targets: ['nvidia-exporter:9835']

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']
    # cadvisor wird optional dazugepackt — deaktiviert bis benötigt
