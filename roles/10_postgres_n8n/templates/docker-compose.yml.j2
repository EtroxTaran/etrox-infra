---
# Geteilter Compose-File für postgres-n8n + n8n-private (Role 11 schreibt n8n-Block).
services:
  postgres-n8n:
    image: postgres:16-alpine
    container_name: postgres-n8n
    restart: unless-stopped
    user: "1002:1002"
    networks: [agent-net]
    environment:
      POSTGRES_DB: "{{ vault_postgres.n8n_db }}"
      POSTGRES_USER: "{{ vault_postgres.n8n_user }}"
      POSTGRES_PASSWORD: "{{ vault_postgres.n8n_password }}"
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - "{{ n8n_postgres_data_dir }}:/var/lib/postgresql/data"
    deploy:
      resources:
        limits:
          memory: 2G
          cpus: "1.0"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ vault_postgres.n8n_user }}"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  agent-net: { external: true }
