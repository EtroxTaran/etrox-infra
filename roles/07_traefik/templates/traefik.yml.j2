api:
  dashboard: true
  insecure: false   # Dashboard nur via Tailscale + Traefik selbst

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

providers:
  docker:
    exposedByDefault: false
    network: agent-net
  file:
    directory: /etc/traefik/config
    watch: true

log:
  level: INFO
accessLog: {}

# ACME via DNS-01 (kein Public HTTP-Challenge auf AI-Server)
certificatesResolvers:
  letsencrypt:
    acme:
      email: "admin@{{ public_domain }}"
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: "{{ vault_dns_provider | default('cloudflare') }}"
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"
