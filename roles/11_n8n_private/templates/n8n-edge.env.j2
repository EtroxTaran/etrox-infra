N8N_DISABLE_UI=true
N8N_ENCRYPTION_KEY={{ vault_n8n_edge_encryption_key }}
WEBHOOK_URL=https://{{ public_subdomains.n8n_gw }}
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE={{ n8n_timezone }}
TZ={{ n8n_timezone }}

# Forward an n8n-private über Tailscale-IP
N8N_FORWARD_TO=http://{{ ai_server_tailnet_ip | default('100.0.0.0') }}:5678
WEBHOOK_SHARED_SECRET={{ vault_n8n_webhook_shared_secret }}

EXECUTIONS_MODE=regular
