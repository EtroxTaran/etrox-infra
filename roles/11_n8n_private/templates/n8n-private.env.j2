DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres-n8n
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE={{ vault_postgres.n8n_db }}
DB_POSTGRESDB_USER={{ vault_postgres.n8n_user }}
DB_POSTGRESDB_PASSWORD={{ vault_postgres.n8n_password }}

GENERIC_TIMEZONE={{ n8n_timezone }}
TZ={{ n8n_timezone }}

N8N_ENCRYPTION_KEY={{ vault_n8n_encryption_key }}
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_LISTEN_ADDRESS=0.0.0.0
WEBHOOK_URL={{ n8n_public_webhook_url }}
N8N_PROXY_HOPS=1

EXECUTIONS_MODE=regular
N8N_RUNNERS_ENABLED=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Telegram-Tokens für Bot-Nodes (über n8n credential store)
NICO_CHAT_ID={{ vault_telegram.nico_chat_id }}
SABINE_CHAT_ID={{ vault_telegram.sabine_chat_id }}
WEBHOOK_SHARED_SECRET={{ vault_n8n_webhook_shared_secret }}

# Discord webhooks (referenced by workflows via $env.DISCORD_*)
DISCORD_CI_WEBHOOK={{ vault_discord.ci_webhook_url }}
DISCORD_HEALTH_WEBHOOK={{ vault_discord.health_webhook_url }}
DISCORD_ERRORS_WEBHOOK={{ vault_discord.errors_webhook_url }}

# AI provider keys (für Agent-Nodes)
ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}
OPENAI_API_KEY={{ vault_openai_api_key }}
OLLAMA_HOST=http://host.docker.internal:11434
